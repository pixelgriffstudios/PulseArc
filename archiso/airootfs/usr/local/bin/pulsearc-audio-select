#!/usr/bin/env bash
set -euo pipefail

# Prefer a connected HDMI/DisplayPort sink for a living-room console.  Fall
# back to the current WirePlumber default when no digital display sink exists.
for _attempt in {1..20}; do
    status=$(wpctl status -n 2>/dev/null || true)
    if [[ -n "$status" ]]; then
        sink_id=$(
            awk '
                /Sinks:/ { in_sinks=1; next }
                /Sources:/ { in_sinks=0 }
                in_sinks && tolower($0) ~ /(hdmi|displayport)/ {
                    for (i=1; i<=NF; i++) {
                        value=$i
                        gsub(/[^0-9.]/, "", value)
                        if (value ~ /^[0-9]+[.]$/) {
                            sub(/[.]$/, "", value)
                            print value
                            exit
                        }
                    }
                }
            ' <<<"$status"
        )
        if [[ -n "$sink_id" ]]; then
            wpctl set-default "$sink_id" || true
            wpctl set-mute "$sink_id" 0 || true
            exit 0
        fi
        exit 0
    fi
    sleep 0.25
done

exit 0
